{
  "id": "auth",
  "name": "Authentication",
  "version": "1.0.0",
  "dependencies": ["env"],
  "adapters": ["node-adapter"],
  "hooks": [
    {
      "event": "after:install",
      "handler": "./hooks/after-install.ts"
    }
  ],
  "validations": [
    {
      "id": "auth-required-env",
      "type": "required-dependency",
      "message": "Auth capability requires the env capability",
      "config": { "dependency": "env" }
    }
  ],
  "ownership": {
    "files": [],
    "dependencies": ["next-auth"],
    "envVars": ["AUTH_SECRET"]
  }
}
