{
  "name": "@kiln-cli/kiln",
  "version": "1.1.0",
  "description": "CLI that scaffolds a Next.js project and adds auth (NextAuth/Auth.js) and environment-variable management with ownership-tracked, idempotent file generation.",
  "keywords": [
    "cli",
    "scaffolding",
    "scaffold",
    "generator",
    "code-generator",
    "boilerplate",
    "starter",
    "starter-kit",
    "nextjs",
    "next.js",
    "react",
    "typescript",
    "auth",
    "authentication",
    "nextauth",
    "next-auth",
    "auth.js",
    "authjs",
    "oauth",
    "env",
    "environment-variables",
    "dotenv",
    "project-generator",
    "developer-tools",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitbhalla1801/kiln.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/arpitbhalla1801/kiln#readme",
  "bugs": {
    "url": "https://github.com/arpitbhalla1801/kiln/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kiln": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@kiln/core": "workspace:*",
    "@kiln/env-capability": "workspace:*",
    "@kiln/node-adapter": "workspace:*",
    "@kiln/planner": "workspace:*",
    "@kiln/project-model": "workspace:*",
    "@kiln/runtime": "workspace:*",
    "@kiln/transform-engine": "workspace:*",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.2",
    "shx": "^0.4.0"
  },
  "scripts": {
    "build": "bunx tsc -b --force && bun run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js && shx chmod +x dist/index.js",
    "prepublishOnly": "bun run build",
    "dev": "bun src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test tests"
  }
}
