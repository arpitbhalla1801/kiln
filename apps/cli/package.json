{
  "name": "@kiln-cli/kiln",
  "version": "2.2.0",
  "description": "kiln: capability-based CLI that adds auth, db and env to Next.js apps",
  "license": "MIT",
  "keywords": [
    "kiln",
    "kiln-cli",
    "cli",
    "nextjs",
    "scaffold",
    "scaffolding",
    "generator",
    "auth",
    "next-auth",
    "prisma",
    "env",
    "capabilities",
    "plugins"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitbhalla1801/kiln.git",
    "directory": "apps/cli"
  },
  "homepage": "https://arpitbhalla1801.github.io/kiln/",
  "bugs": {
    "url": "https://github.com/arpitbhalla1801/kiln/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kiln": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@kiln-cli/capability-sdk": "workspace:*",
    "@kiln-cli/core": "workspace:*",
    "@kiln-cli/env-capability": "workspace:*",
    "@kiln-cli/node-adapter": "workspace:*",
    "@kiln-cli/planner": "workspace:*",
    "@kiln-cli/project-model": "workspace:*",
    "@kiln-cli/runtime": "workspace:*",
    "@kiln-cli/transform-engine": "workspace:*",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.2",
    "shx": "^0.4.0"
  },
  "scripts": {
    "build": "bunx tsc -b --force && bun run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js && shx chmod +x dist/index.js",
    "prepublishOnly": "bun run build",
    "dev": "bun src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test tests"
  }
}
